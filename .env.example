# All optional — the journal boots with none of these set.

# Require a password to open the journal (recommended when exposed beyond localhost).
# JOURNAL_PASSWORD=

# Encryption key source for broker credentials at rest.
# Default: a random key file generated next to the database.
# JOURNAL_SECRET=

# Where the SQLite database lives. Default: ./data
# JOURNAL_DATA_DIR=

# AI features (session recaps, trade critiques, ask-your-journal).
# Can also be set on the Settings page (stored encrypted).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# If only OPENAI_API_KEY is set, OpenAI is selected automatically.
# If both keys are set, Anthropic stays the default until you choose a provider in Settings.
# Provider and model choices are saved in Settings; environment keys take precedence over saved keys.

# Optional market data: no provider is configured or enabled by this template.
# Choose a connection or upload candle CSVs in Settings > Market data.
# Provider-specific environment configuration is documented in docs/market-data.md.

# MarketLab Backtests replay (Phase F). Both paths are local and read-only.
# MARKETLAB_REPLAY_PACKAGE: the finalized LEAN Phase E replay directory
#   (<run>\storage\single-anchor\replay) or the run directory itself.
# MARKETLAB_CANDLE_CACHE: the derived M1 candle cache directory
#   (contains manifest.json and xauusd-m1-YYYY-MM.csv).
# Optional identity anchors; when set, the loaded package/cache must match.
# MARKETLAB_REPLAY_EXPECTED_PACKAGE_SHA256=
# MARKETLAB_EXPECTED_CANDLE_CONTENT_SHA256=
# MARKETLAB_REPLAY_PACKAGE=
# MARKETLAB_CANDLE_CACHE=
